<ul class="social-links" aria-label="Контакты">
  {% if metadata.social.github %}<li><a href="{{ metadata.social.github }}" aria-label="GitHub"><span aria-hidden="true">{% icon "custom:github" %}</span></a></li>{% endif %}
  {% if metadata.social.mastodon %}<li><a rel="me" href="{{ metadata.social.mastodon }}" aria-label="Mastodon"><span aria-hidden="true">{% icon "custom:mastodon" %}</span></a></li>{% endif %}
  {% if telegram.channelUrl %}<li><a href="{{ telegram.channelUrl }}" aria-label="Telegram"><span aria-hidden="true">{% icon "custom:telegram" %}</span></a></li>{% endif %}
  {% if metadata.social.twitter %}<li><a href="{{ metadata.social.twitter }}" aria-label="Twitter"><span aria-hidden="true">{% icon "custom:twitter" %}</span></a></li>{% endif %}
  {% if metadata.social.vk %}<li><a href="{{ metadata.social.vk }}" aria-label="ВКонтакте"><span aria-hidden="true">{% icon "custom:vk" %}</span></a></li>{% endif %}
  {% if metadata.social.cv %}<li><a class="cv" href="{{ metadata.social.cv }}" aria-label="Резюме"><span aria-hidden="true">{% icon "custom:readdotcv" %}</span> CV</a></li>{% endif %}
  <li class="email"><a href="mailto:pechorin.andrey@ya.ru">pechorin.andrey@ya.ru</a></li>
</ul>
