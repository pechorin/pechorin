<section class="jobs" aria-labelledby="jobs-title">
  <p class="section-label">02 / Опыт</p>
  <h2 id="jobs-title">{{ metadata.jobs.title | replace(':', '') }}</h2>

  <ul class="job-list">
    {% for job in jobs %}
      <li class="job">
        <div class="job-heading">
          <h3 class="company">
            {% if job.url %}<a href="{{ job.url }}">{{ job.company }}</a>{% else %}{{ job.company }}{% endif %}
          </h3>
          <span class="years">{{ job.years }}</span>
        </div>
        <p class="position">{{ job.position }}</p>
      </li>
    {% endfor %}
  </ul>

  {% if metadata.social.cv %}
    <a href="{{ metadata.social.cv }}" class="all-jobs" aria-label="CV, все места работы">
      <span aria-hidden="true">{% icon "custom:readdotcv" %}</span> CV
    </a>
  {% endif %}
</section>
