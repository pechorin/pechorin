<section class="repositories" aria-labelledby="projects-title">
  <p class="section-label">01 / Проекты</p>
  <h2 id="projects-title">{{ metadata.repositories.title | safe }}</h2>
  <p class="section-description">{{ metadata.repositories.description }}</p>

  <ul class="repository-list">
    {% for repo in repositories %}
      <li class="repository">
        <div class="repository-heading">
          <h3 class="name"><a href="{{ repo.url }}">{{ repo.name }}</a></h3>
          {% if repo.stars %}
            <span class="stars" aria-label="{{ repo.stars }} звёзд на GitHub">{{ repo.stars }}</span>
          {% endif %}
        </div>
        {% if repo.description %}<p class="description">{{ repo.description }}</p>{% endif %}
        {% if repo.tags | length %}
          <ul class="tags" aria-label="Технологии">
            {% for tag in repo.tags %}<li>{{ tag }}</li>{% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
