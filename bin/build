#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

npm ci --include=dev
# Validate without printing credentials; dotenv also supports local builds.
node <<'NODE'
require('dotenv').config()
const config = require('./lib/config')
const required = []
if (config.s3Enabled) {
  required.push('S3_ENDPOINT', 'S3_REGION', 'S3_BUCKET', 'S3_KEY_ID', 'S3_ACCESS_KEY')
}
if (config.telegramEnabled && !config.loadFromS3Only) {
  required.push('TELEGRAM_BOT_TOKEN', 'TELEGRAM_CHANNEL_ID', 'TELEGRAM_CHANNEL_URL')
}
const missing = required.filter(key => !process.env[key])
if (missing.length) {
  console.error(`Missing build configuration: ${missing.join(', ')}`)
  process.exit(1)
}
require('node:fs').rmSync('build', { recursive: true, force: true })
NODE
npm run prod
test -s build/index.html
